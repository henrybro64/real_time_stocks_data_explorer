# Copy to terraform.tfvars (gitignored) and fill in values.
# Never commit real passwords or home IP addresses.

project_name = "starchive"
location     = "eastus"

# Secure default is private-only. Home/dev PoC needs public access + firewall IP.
enable_public_network_access = true
allowed_client_ipv4          = "203.0.113.10"

# Optional overrides:
# resource_group_name = "starchive-rg"
# sql_server_name     = "starchivexxxxxx"
# sql_database_name   = "rankings_archive"
# sql_admin_login     = "starchive_admin"
# sql_admin_password  = "replace-with-strong-password"
