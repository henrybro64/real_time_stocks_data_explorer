# --- Same-origin (default): UI at /, API at /api ---
# Leave NEXT_PUBLIC_API_BASE_URL unset. The browser requests `/api/...` on the current origin;
# Next.js rewrites forward to the backend (see BACKEND_PROXY_URL).

# Where Next.js proxies `/api/*` in dev (FastAPI default).
# BACKEND_PROXY_URL=http://127.0.0.1:8000

# Optional: must match backend API_PREFIX (default /api).
# NEXT_PUBLIC_API_PREFIX=/api

# --- Direct API (skip Next proxy; set CORS on backend) ---
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
