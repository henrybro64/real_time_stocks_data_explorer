# -----------------------------------------------------------------------------
# Dependencies (never commit — reinstall from lockfiles / requirements)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/

# Python environments
.venv/
.venv-ci/
venv/
ENV/
env/

# -----------------------------------------------------------------------------
# Python: bytecode, caches, packaging & binary artifacts
# -----------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
# setuptools / pip / build (sdist, wheel, editable installs)
# Note: sdist/wheel archives usually land in ./dist/ — already ignored above.
*.egg
*.egg-info/
*.dist-info/
.eggs/
build/
dist/
pip-wheel-metadata/
pip-download-cache/
wheelhouse/
*.whl

# Type checkers / linters (local caches)
.mypy_cache/
.dmypy.json
.pytype/
.pyre/
.ruff_cache/
.bandit
.pylint.d/
.hypothesis/
.pytest_cache/
.tox/
.nox/

# Virtualenv / tooling (uv, pipenv, etc.)
.uv/
.pip/

# -----------------------------------------------------------------------------
# Node / frontend: build outputs & Vite
# -----------------------------------------------------------------------------
frontend/dist/
frontend/out/
packages/*/dist/
**/dist/
**/dist-ssr/
**/storybook-static/
frontend/.next/
**/.next/

# Vite caches
.vite/
**/.vite/

# Bundler / tooling caches
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
# Next.js webpack cache packfiles
**/.next/cache/webpack/**/*.pack

# Test coverage (JS)
coverage/
**/coverage/
.nyc_output/
*.lcov
lcov.info

# -----------------------------------------------------------------------------
# Environment & secrets (never commit real credentials)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.local
# Home-node Azure rankings archive secret (copy from .example, fill locally)
k8s/backend-rankings-archive-secret.yaml
# Local auth / session secrets (copy from .example or generated by deploy-k3s.sh)
k8s/backend-auth-secret.yaml
# Entra External ID client id/secret (copy from .example; never commit values)
k8s/backend-entra-secret.yaml
# Home-node AWS heartbeat credentials (copy from .example, fill locally)
k8s/aws-health-heartbeat-secret.yaml
# Local AWS CLI installer unpack (never commit)
awscli-bundle/
awscli-bundle.zip

# -----------------------------------------------------------------------------
# IDE & local editor state
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~

# Cursor — ignore local project cache; allow shared rules to be committed
.cursor/*
!.cursor/rules/

# Local Playwright MCP workspace state
.playwright-mcp/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Logs & temp
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.bak
*.tmp
*.temp

# -----------------------------------------------------------------------------
# Local databases / runtime files (if added later)
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Deployment / hosting (CLI artifacts)
# -----------------------------------------------------------------------------
.vercel/
.netlify/
.sentryclirc

# -----------------------------------------------------------------------------
# Playwright / E2E (if added later)
# -----------------------------------------------------------------------------
playwright-report/
test-results/
blob-report/
playwright/.cache/
allure-results/
allure-report/
artifacts/k3s-smoke/

# -----------------------------------------------------------------------------
# Jupyter (if notebooks are added)
# -----------------------------------------------------------------------------
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Docs builds (if Sphinx/MkDocs added later)
# -----------------------------------------------------------------------------
docs/_build/
site/
