# API route prefix (must match frontend NEXT_PUBLIC_API_PREFIX, default /api)
# API_PREFIX=/api

# Comma-separated browser origins allowed for CORS when the UI and API are on different hosts.
# For same-origin (recommended: UI at /, API at /api), you can still set your public site origin if needed.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres connection URL (required at backend startup).
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/stocks

# Redis cache connection URL (optional but recommended for quote/news caching).
# Example:
# REDIS_URL=redis://127.0.0.1:6379/0

# Backend logging:
# LOG_LEVEL=INFO
# LOG_FORMAT=console
# REQUEST_ID_HEADER=X-Request-ID

# Single-user mode uses the fixed system principal "default-user".
# The backend startup seeds that row automatically when AUTH_ENABLED=false.

# --- Multi-user local auth (optional) ---
# When AUTH_ENABLED=true, the API uses session cookies; watchlist/portfolio/AI keys are per user.
# When false, all user-owned routes run as the seeded "default-user" principal.
#
# AUTH_ENABLED=false
#
# Required when AUTH_ENABLED=true:
# - SESSION_SECRET must be at least 16 characters (use a long random string in production).
# - LOCAL_AUTH_ENABLED=true
# - Users can self-register on /login with username + password
# - Optional bootstrap admin account: set LOCAL_AUTH_USERNAME + LOCAL_AUTH_PASSWORD
#
# SESSION_SECRET=change-me-to-a-long-random-string
# LOCAL_AUTH_ENABLED=true
# LOCAL_AUTH_USERNAME=admin
# LOCAL_AUTH_PASSWORD=change-me-local-password

# Internal token for snapshot capture endpoint:
# POST /api/portfolio/history/capture with header X-Portfolio-History-Token
# PORTFOLIO_HISTORY_CAPTURE_TOKEN=replace-with-long-random-token

# --- Provider-agnostic AI stock analysis (optional) ---
# The stock-detail "AI stock analysis" panel calls /api/stocks/{stock_id}/analysis.
# The backend always computes metrics from 1 year of yfinance daily history first.
# If no AI provider is configured, the endpoint still returns computedData + warnings.
#
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
