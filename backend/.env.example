# API route prefix (must match frontend NEXT_PUBLIC_API_PREFIX, default /api)
# API_PREFIX=/api

# Comma-separated browser origins allowed for CORS when the UI and API are on different hosts.
# For same-origin (recommended: UI at /, API at /api), you can still set your public site origin if needed.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres connection URL (required at backend startup).
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/stocks

# Redis cache connection URL (optional but recommended for quote/news caching).
# Example:
# REDIS_URL=redis://127.0.0.1:6379/0

# Default single-user seed id (currently fixed in code to "default-user").

# --- Multi-user OAuth (optional) ---
# When AUTH_ENABLED=true, the API uses session cookies and OAuth; watchlist/portfolio/AI keys are per user.
# When false, all requests use user id "default-user" (single-user mode).
#
# AUTH_ENABLED=false
#
# Required when AUTH_ENABLED=true:
# - SESSION_SECRET must be at least 16 characters (use a long random string in production).
# - PUBLIC_BASE_URL = browser origin of the Next app (OAuth redirects), e.g. http://localhost:3000
#
# SESSION_SECRET=change-me-to-a-long-random-string
# PUBLIC_BASE_URL=http://localhost:3000
#
# Configure at least one provider. Register each redirect URI with the provider:
#   {PUBLIC_BASE_URL}{API_PREFIX}/auth/callback/google
#   {PUBLIC_BASE_URL}{API_PREFIX}/auth/callback/microsoft
#   {PUBLIC_BASE_URL}{API_PREFIX}/auth/callback/apple
# Example for defaults: http://localhost:3000/api/auth/callback/google
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=consumers
#
# Apple Sign In (service ID, team, key id, PEM private key; newlines in PEM can be escaped as \n)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Set true only for offline demos. Synthetic TW quotes are not real market prices.
# TW_USE_MOCK_QUOTES=false
