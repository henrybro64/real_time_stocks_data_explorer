# API route prefix (must match frontend NEXT_PUBLIC_API_PREFIX, default /api)
# API_PREFIX=/api

# Comma-separated browser origins allowed for CORS when the UI and API are on different hosts.
# For same-origin (recommended: UI at /, API at /api), you can still set your public site origin if needed.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
