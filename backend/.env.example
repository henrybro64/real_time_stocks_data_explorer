# API route prefix (must match frontend NEXT_PUBLIC_API_PREFIX, default /api)
# API_PREFIX=/api

# Comma-separated browser origins allowed for CORS when the UI and API are on different hosts.
# For same-origin (recommended: UI at /, API at /api), you can still set your public site origin if needed.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres connection URL (required at backend startup).
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/stocks

# Redis cache connection URL (optional but recommended for quote/news caching).
# Example:
# REDIS_URL=redis://127.0.0.1:6379/0
#
# Quote cache soft/hard TTL and refresh dedupe (seconds):
# QUOTE_CACHE_TTL_SECONDS=60
# QUOTE_CACHE_HARD_TTL_SECONDS=3600
# QUOTE_REFRESH_LOCK_SECONDS=30
#
# Redis reconnect backoff after connect/runtime failures (#132):
# QUOTE_REDIS_RETRY_BASE_SECONDS=5
# QUOTE_REDIS_RETRY_MAX_SECONDS=60
# QUOTE_REDIS_RETRY_JITTER_SECONDS=2
#
# Background quote refresher (#130) — keeps watchlist/portfolio symbols warm:
# QUOTE_REFRESHER_ENABLED=true
# QUOTE_REFRESHER_OWNS_UPSTREAM=true
# QUOTE_REFRESHER_OPEN_POLL_SECONDS=45
# QUOTE_REFRESHER_CLOSED_POLL_SECONDS=900
# QUOTE_REFRESHER_MAX_CONCURRENCY=3
# QUOTE_REFRESHER_MIN_INTERVAL_SECONDS=0.35
# QUOTE_REFRESHER_CYCLE_TIMEOUT_SECONDS=40
# QUOTE_REFRESHER_JITTER_SECONDS=2
# QUOTE_REFRESHER_CIRCUIT_FAILURE_THRESHOLD=5
# QUOTE_REFRESHER_CIRCUIT_OPEN_SECONDS=120

# Backend logging:
# LOG_LEVEL=INFO
# LOG_FORMAT=console
# REQUEST_ID_HEADER=X-Request-ID
#
# Alert evaluator background loop (polls enabled alert rules):
# ALERT_EVALUATOR_ENABLED=true
# ALERT_EVALUATOR_POLL_SECONDS=60

# Single-user mode uses the fixed system principal "default-user".
# The backend startup seeds that row automatically when AUTH_ENABLED=false.

# --- Multi-user local auth (optional) ---
# When AUTH_ENABLED=true, the API uses session cookies; watchlist/portfolio/AI keys are per user.
# When false, all user-owned routes run as the seeded "default-user" principal.
#
# AUTH_ENABLED=false
#
# Required when AUTH_ENABLED=true:
# - SESSION_SECRET must be at least 16 characters (use a long random string in production).
# - LOCAL_AUTH_ENABLED=true
# - Users can self-register on /login with username + password
# - Optional bootstrap admin account: set LOCAL_AUTH_USERNAME + LOCAL_AUTH_PASSWORD
#
# SESSION_SECRET=change-me-to-a-long-random-string
# LOCAL_AUTH_ENABLED=true
# LOCAL_AUTH_USERNAME=admin
# LOCAL_AUTH_PASSWORD=change-me-local-password

# Internal token for snapshot capture endpoint:
# POST /api/portfolio/history/capture with header X-Portfolio-History-Token
# PORTFOLIO_HISTORY_CAPTURE_TOKEN=replace-with-long-random-token

# Rankings snapshot persistence and scheduler (free-only):
# RANKINGS_SNAPSHOT_ENABLED=true
# RANKINGS_REFRESH_SECONDS=1800
# RANKINGS_MANUAL_REFRESH_COOLDOWN_SECONDS=15
# RANKINGS_UNIVERSE_US=AAPL,MSFT,NVDA,MU,TSLA,AMD,META,AMZN,GOOGL
# RANKINGS_UNIVERSE_TW=0050,2330,2317,2454,2303,2881,2882,6488,8299,8271,6215,6643,6562,6451,6462
#
# Optional internal token for POST /api/rankings/snapshots/capture
# header: X-Rankings-Capture-Token
# RANKINGS_CAPTURE_TOKEN=replace-with-long-random-token

# Optional Azure SQL rankings archive (#165–#167). Never reuse DATABASE_URL.
# Leave unset so FastAPI and GET /api/rankings work without Azure.
# Requires ODBC Driver 18 + pyodbc when using mssql+pyodbc://...
# RANKINGS_ARCHIVE_DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER.database.windows.net:1433/rankings_archive?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# RANKINGS_ARCHIVE_EOD_ENABLED=false
# RANKINGS_ARCHIVE_EOD_POLL_SECONDS=900
# Optional token for POST /api/rankings/archive/capture
# header: X-Rankings-Archive-Capture-Token
# RANKINGS_ARCHIVE_CAPTURE_TOKEN=replace-with-long-random-token

# Taiwan detail-page market data (write-side #97; institutional store reads #105).
# RECENT_DAYS also sizes institutional read freshness + bounded live fallback.
# Cold start: run capture/backfill before expecting ~90-day detail history.
# TAIWAN_MARKET_DATA_REFRESH_ENABLED=true
# TAIWAN_MARKET_DATA_REFRESH_DAYS=120
# TAIWAN_MARKET_DATA_REFRESH_RECENT_DAYS=7
# TAIWAN_MARKET_DATA_REFRESH_POLL_SECONDS=3600
# TAIWAN_MARKET_DATA_REFRESH_HOUR=18
# TAIWAN_MARKET_DATA_TIMEZONE=Asia/Taipei
#
# Optional internal token for POST /api/taiwan-market-data/capture?days=120
# header: X-Taiwan-Market-Data-Token
# TAIWAN_MARKET_DATA_CAPTURE_TOKEN=replace-with-long-random-token

# --- Provider-agnostic AI stock analysis (optional) ---
# The stock-detail "AI stock analysis" panel calls /api/stocks/{stock_id}/analysis.
# The backend always computes metrics from 1 year of yfinance daily history first.
# If no AI provider is configured, the endpoint still returns computedData + warnings.
#
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
