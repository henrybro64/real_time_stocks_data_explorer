# Copy to aws-health-heartbeat-secret.yaml (gitignored) after terraform apply.
# Never commit real AWS credentials.
#
#   cd infra/aws-health-monitor
#   terraform output -raw create_access_key_command
#   # run that command, then fill values below from terraform outputs:
#   #   AWS_REGION, TABLE_NAME, SERVICE_NAME, TTL_DAYS
#   kubectl -n stock-ticker apply -f k8s/aws-health-heartbeat-secret.yaml
#   kubectl -n stock-ticker patch cronjob stock-ticker-aws-health-heartbeat \
#     -p '{"spec":{"suspend":false}}'
apiVersion: v1
kind: Secret
metadata:
  name: stock-ticker-aws-health-heartbeat
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIAREPLACE"
  AWS_SECRET_ACCESS_KEY: "replace-with-secret-access-key"
  AWS_REGION: "us-east-1"
  TABLE_NAME: "stock-ticker-health-heartbeats"
  SERVICE_NAME: "stock-ticker-backend"
  TTL_DAYS: "7"
