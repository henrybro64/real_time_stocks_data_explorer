# Copy to backend-rankings-archive-secret.yaml (gitignored locally if you prefer)
# and fill in values from `terraform output` under infra/azure-rankings-archive.
# URL-encode the SQL password. Never commit real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: stock-ticker-backend-rankings-archive
type: Opaque
stringData:
  # mssql+pyodbc://USER:URL_ENCODED_PASSWORD@SERVER.database.windows.net:1433/rankings_archive_free?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
  RANKINGS_ARCHIVE_DATABASE_URL: "mssql+pyodbc://REPLACE_USER:REPLACE_PASSWORD@REPLACE_SERVER.database.windows.net:1433/rankings_archive_free?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no"
  RANKINGS_ARCHIVE_EOD_ENABLED: "true"
  RANKINGS_ARCHIVE_EOD_POLL_SECONDS: "900"
  RANKINGS_ARCHIVE_RETENTION_DAYS: "730"
  RANKINGS_ARCHIVE_CAPTURE_TOKEN: "replace-with-long-random-token"
