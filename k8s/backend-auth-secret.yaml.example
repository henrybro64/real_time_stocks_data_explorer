# Copy to backend-auth-secret.yaml (gitignored) or let ./scripts/deploy-k3s.sh
# generate it. Never commit real credentials (#267).
apiVersion: v1
kind: Secret
metadata:
  name: stock-ticker-backend-auth
type: Opaque
stringData:
  # Required when AUTH_ENABLED=true. Must not be a placeholder; use e.g.:
  #   openssl rand -hex 32
  SESSION_SECRET: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  # Optional bootstrap local-auth credentials. Leave both empty to rely on
  # self-registration only. Bootstrap is create-only: an existing username keeps
  # its stored password unless LOCAL_AUTH_RESET_PASSWORD=true (#286).
  # Password must be at least 8 characters and must not be a known placeholder.
  LOCAL_AUTH_USERNAME: ""
  LOCAL_AUTH_PASSWORD: ""
  # Header token for POST /api/portfolio/history/capture. Empty disables.
  # Use `openssl rand -hex 24` — do not leave a REPLACE_* placeholder (#284).
  PORTFOLIO_HISTORY_CAPTURE_TOKEN: ""
  # Secure cookies require HTTPS. Keep false for plain HTTP Ingress (#241 / #267).
  # deploy-k3s.sh sets this to "true" for https and back to "false" for http (#299).
  SESSION_COOKIE_SECURE: "false"
