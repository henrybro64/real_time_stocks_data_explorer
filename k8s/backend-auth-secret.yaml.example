# Copy to backend-auth-secret.yaml (gitignored) or let ./scripts/deploy-k3s.sh
# generate it. Never commit real credentials (#267).
apiVersion: v1
kind: Secret
metadata:
  name: stock-ticker-backend-auth
type: Opaque
stringData:
  # Required when AUTH_ENABLED=true. Must not be a placeholder; use e.g.:
  #   openssl rand -hex 32
  SESSION_SECRET: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  # Optional bootstrap local-auth credentials. Leave both empty to rely on
  # self-registration only. Password must be at least 8 characters and must
  # not be a known placeholder such as change-me-local-password.
  LOCAL_AUTH_USERNAME: ""
  LOCAL_AUTH_PASSWORD: ""
  # Header token for POST /api/portfolio/history/capture (CronJob). Empty disables.
  PORTFOLIO_HISTORY_CAPTURE_TOKEN: "REPLACE_WITH_RANDOM_CAPTURE_TOKEN"
  # Secure cookies require HTTPS. Keep false for plain HTTP Ingress (#241 / #267).
  SESSION_COOKIE_SECURE: "false"
