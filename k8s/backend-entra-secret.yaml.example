# Copy to backend-entra-secret.yaml (gitignored) only when the cluster does
# not already have Secret stock-ticker-entra. Never commit the secret value.
# The live cluster already uses this name and the key ENTRA_CLIENT_SECRET.
# Do not add ENTRA_CLIENT_ID here; it lives in the ConfigMap and a later
# envFrom would override it (#299).
apiVersion: v1
kind: Secret
metadata:
  name: stock-ticker-entra
type: Opaque
stringData:
  ENTRA_CLIENT_SECRET: ""
