# Copy to backend-entra-secret.yaml (gitignored) and fill locally.
# Apply with: kubectl -n stock-ticker apply -f k8s/backend-entra-secret.yaml
# Never commit real credentials (#299). Last envFrom on the backend/worker
# so these keys override empty ConfigMap placeholders.
apiVersion: v1
kind: Secret
metadata:
  name: stock-ticker-backend-entra
type: Opaque
stringData:
  # Application (client) ID from the Entra External ID app registration.
  ENTRA_CLIENT_ID: ""
  # Client secret from the same app registration. Rotate in Entra, then patch
  # this Secret. An invalid or stale secret is the usual cause of token HTTP 401
  # (invalid_client / AADSTS7000215). Leave empty only for a public client.
  ENTRA_CLIENT_SECRET: ""
